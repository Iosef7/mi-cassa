generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  name          String?
  role          String         @default("AGENT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  phone         String?
  socialLinks   String?
  accounts      Account[]
  appointments  Appointment[]
  leads         Lead[]
  notifications Notification[]
  sessions      Session[]
  tasks         Task[]
  taskAuditLogs TaskAuditLog[]
  taskComments  TaskComment[]
  brokerageContracts BrokerageContract[]
}

model Property {
  id              String   @id @default(cuid())
  title           String
  description     String?
  price           Decimal
  type            String
  status          String   @default("DISPONIBLE")
  location        String
  bedrooms        Int?
  bathrooms       Int?
  area            Float?
  images          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  operationType   String   @default("VENTA")
  availableUnits  Int?
  deliveryDate    String?
  maxPrice        Decimal?
  minPrice        Decimal?
  presentations   String?
  ownerEmail      String?
  ownerName       String?
  ownerPhone      String?
  ownerNotes      String?
  dynamicFeatures String?
  nearbyPlaces    String?
  independentUnit String?
  driveFolderId   String?
  commissions     String?
  developmentProjectId String?
  developmentProject   DevelopmentProject? @relation(fields: [developmentProjectId], references: [id])
  leads           Lead[]
  tasks           Task[]
  brokerageContracts BrokerageContract[]

  @@index([operationType])
  @@index([status])
  @@index([createdAt])
}

model Lead {
  id               String        @id @default(cuid())
  name             String
  email            String?
  phone            String
  status           String        @default("NUEVO")
  budget           Decimal?
  currency         String        @default("ILS") // Moneda (ILS, USD, etc)
  notes            String?
  source           String?
  agentId          String?
  propertyId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  preferences      String?
  requiresMortgage Boolean       @default(false)
  type             String        @default("CLIENTE") // CLIENTE o PROPIETARIO
  urgency          String?       // Alta, Media, Baja
  propertyTypeOfInterest String? // Casa, Departamento, Terreno, etc.
  hasPropertyToSell Boolean      @default(false)
  reasonForSelling String?       // Inversión, Mudanza, Herencia, etc.
  acceptsTrade     Boolean       @default(false)
  viewingAvailability String?    // Fines de semana, Mañanas, etc.
  targetLocations  String?       // Norte, Centro, Sur, etc.
  targetArea       Float?        // Area esperada (m2)
  minArea          Float?        // Area minima (m2)
  maxArea          Float?        // Area maxima (m2)
  moveInDate       DateTime?     // Fecha de llegada o inicio contrato
  numberOfPeople   Int?          // Número de personas
  petFriendly      Boolean       @default(false) // Mascotas permitidas
  isLegalClear     Boolean       @default(true)  // ¿Documentos al día?
  hasMortgage      Boolean       @default(false) // ¿Libre de gravamen?
  mandateType      String?       // Exclusiva, Abierta, Ninguna
  appointments     Appointment[]
  calls            Call[]
  agent            User?         @relation(fields: [agentId], references: [id])
  property         Property?     @relation(fields: [propertyId], references: [id])
  messages         Message[]
  tasks            Task[]
  contactDate      DateTime?
  brokerageContracts BrokerageContract[]
  whatsAppMessages   WhatsAppMessage[]

  @@index([status])
  @@index([type])
  @@index([agentId])
  @@index([createdAt])
}

model Appointment {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("PENDIENTE")
  leadId    String
  agentId   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     User?    @relation(fields: [agentId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  content   String
  fromBot   Boolean  @default(false)
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Call {
  id            String   @id @default(cuid())
  leadId        String
  duration      Int
  audioUrl      String?
  transcription String?
  summary       String?
  mainTopic     String?
  keyPoints     String?
  commitments   String?
  sentiment     String?
  createdAt     DateTime @default(now())
  lead          Lead     @relation(fields: [leadId], references: [id])
}

model TaskList {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id             String           @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  assignedTo     String?
  leadId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  status         String           @default("PENDIENTE")
  isImportant    Boolean          @default(false)
  listId         String?
  order          Int?
  propertyId     String?
  developmentProjectId String?
  recurrenceRule String?
  subtasks       Subtask[]
  agent          User?            @relation(fields: [assignedTo], references: [id])
  lead           Lead?            @relation(fields: [leadId], references: [id])
  list           TaskList?        @relation(fields: [listId], references: [id])
  property       Property?        @relation(fields: [propertyId], references: [id])
  developmentProject DevelopmentProject? @relation(fields: [developmentProjectId], references: [id])
  attachments    TaskAttachment[]
  auditLogs      TaskAuditLog[]
  comments       TaskComment[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String?
  read      Boolean  @default(false)
  link      String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  isPublished Boolean   @default(false)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sections    Section[]
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  order     Int      @default(0)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id               String   @id @default(cuid())
  provider         String
  model            String
  operationType    String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUSD          Float    @default(0.0)
  status           String   @default("SUCCESS")
  errorMessage     String?
  createdAt        DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  role      String   @default("AGENT")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Subtask {
  id          String   @id @default(cuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id        String   @id @default(cuid())
  url       String
  filename  String
  taskId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model DevelopmentProject {
  id              String   @id @default(cuid())
  name            String
  location        String?
  architect       String?
  totalUnits      Int?
  floors          Int?
  description     String?
  status          String   @default("EVALUACION")
  dealType        String?
  ownershipShare  Float?
  estimatedCost   Decimal?
  expectedRevenue Decimal?
  driveFolderId   String?
  attachments     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  financialData   Json?
  
  properties      Property[]
  tasks           Task[]
}

model WhatsappStatus {
  id          String   @id @default(cuid())
  mediaUrls   String   @default("[]") // JSON stringified array of URLs
  caption     String?  // Text for the status
  status      String   @default("SCHEDULED") // SCHEDULED, PUBLISHED, FAILED
  publishAt   DateTime? // When it should be uploaded (null means immediate)
  publishedAt DateTime? // When it was actually uploaded
  errorMessage String?
  recurringInterval String? // "DAILY", "WEEKLY", etc
  sessionIds  String?  // JSON array of session IDs
  expiresAt   DateTime? // Limit date for recurring schedules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrokerageContract {
  id             String    @id @default(cuid())
  token          String    @unique
  leadId         String
  propertyId     String
  agentId        String
  commissionRate Float
  status         String    @default("PENDIENTE") // PENDIENTE, FIRMADO
  signatureImage String?   @db.Text
  signerIp       String?
  signerIdNumber String?
  signerPhone    String?
  signedAt       DateTime?
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent          User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model WhatsAppSession {
  id               String   @id @default(cuid())
  name             String
  sessionId        String   @unique
  isConnected      Boolean  @default(false)
  isDefaultSender  Boolean  @default(false)
  currentQr        String?  @db.Text
  pairingCode      String?  @db.Text
  contacts         String?  @db.Text // JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  messages         WhatsAppMessage[]
}

model WhatsAppAuth {
  id        String   @id @default(cuid())
  sessionId String
  keyId     String   // The key used by Baileys
  keyData   String   @db.Text // JSON stringified state
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, keyId])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  sessionId String
  remoteJid String   
  fromMe    Boolean  @default(false)
  messageId String   
  content   String   @db.Text
  status    String   @default("PENDING") 
  timestamp DateTime @default(now())

  session   WhatsAppSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([sessionId, remoteJid])
}

model SystemSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
