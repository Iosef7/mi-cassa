generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  name          String?
  role          String         @default("AGENT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  phone         String?
  socialLinks   String?
  accounts      Account[]
  appointments  Appointment[]
  leads         Lead[]
  notifications Notification[]
  sessions      Session[]
  tasks         Task[]
  taskAuditLogs TaskAuditLog[]
  taskComments  TaskComment[]
}

model Property {
  id              String   @id @default(cuid())
  title           String
  description     String?
  price           Decimal
  type            String
  status          String   @default("DISPONIBLE")
  location        String
  bedrooms        Int?
  bathrooms       Int?
  area            Float?
  images          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  availableUnits  Int?
  deliveryDate    String?
  maxPrice        Decimal?
  minPrice        Decimal?
  presentations   String?
  ownerEmail      String?
  ownerName       String?
  ownerPhone      String?
  ownerNotes      String?
  dynamicFeatures String?
  nearbyPlaces    String?
  independentUnit String?
  driveFolderId   String?
  commissions     String?
  leads           Lead[]
  tasks           Task[]
}

model Lead {
  id               String        @id @default(cuid())
  name             String
  email            String?
  phone            String
  status           String        @default("NUEVO")
  budget           Decimal?
  notes            String?
  source           String?
  agentId          String?
  propertyId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  preferences      String?
  requiresMortgage Boolean       @default(false)
  type             String        @default("CLIENTE") // CLIENTE o PROPIETARIO
  urgency          String?       // Alta, Media, Baja
  propertyTypeOfInterest String? // Casa, Departamento, Terreno, etc.
  hasPropertyToSell Boolean      @default(false)
  reasonForSelling String?       // Inversión, Mudanza, Herencia, etc.
  acceptsTrade     Boolean       @default(false)
  viewingAvailability String?    // Fines de semana, Mañanas, etc.
  targetLocations  String?       // Norte, Centro, Sur, etc.
  isLegalClear     Boolean       @default(true)  // ¿Documentos al día?
  hasMortgage      Boolean       @default(false) // ¿Libre de gravamen?
  mandateType      String?       // Exclusiva, Abierta, Ninguna
  appointments     Appointment[]
  calls            Call[]
  agent            User?         @relation(fields: [agentId], references: [id])
  property         Property?     @relation(fields: [propertyId], references: [id])
  messages         Message[]
  tasks            Task[]
}

model Appointment {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  status    String   @default("PENDIENTE")
  leadId    String
  agentId   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     User?    @relation(fields: [agentId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  content   String
  fromBot   Boolean  @default(false)
  leadId    String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Call {
  id            String   @id @default(cuid())
  leadId        String
  duration      Int
  audioUrl      String?
  transcription String?
  summary       String?
  mainTopic     String?
  keyPoints     String?
  commitments   String?
  sentiment     String?
  createdAt     DateTime @default(now())
  lead          Lead     @relation(fields: [leadId], references: [id])
}

model TaskList {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id             String           @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  assignedTo     String?
  leadId         String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  status         String           @default("PENDIENTE")
  isImportant    Boolean          @default(false)
  listId         String?
  order          Int?
  propertyId     String?
  recurrenceRule String?
  subtasks       Subtask[]
  agent          User?            @relation(fields: [assignedTo], references: [id])
  lead           Lead?            @relation(fields: [leadId], references: [id])
  list           TaskList?        @relation(fields: [listId], references: [id])
  property       Property?        @relation(fields: [propertyId], references: [id])
  attachments    TaskAttachment[]
  auditLogs      TaskAuditLog[]
  comments       TaskComment[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String?
  read      Boolean  @default(false)
  link      String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Page {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  isPublished Boolean   @default(false)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sections    Section[]
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  order     Int      @default(0)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id               String   @id @default(cuid())
  provider         String
  model            String
  operationType    String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUSD          Float    @default(0.0)
  status           String   @default("SUCCESS")
  errorMessage     String?
  createdAt        DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  role      String   @default("AGENT")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Subtask {
  id          String   @id @default(cuid())
  title       String
  isCompleted Boolean  @default(false)
  taskId      String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id        String   @id @default(cuid())
  url       String
  filename  String
  taskId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}
